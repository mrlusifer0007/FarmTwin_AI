DATABASE_URL=postgresql+pg8000://agritwin:agritwin@localhost:5432/agritwin
CORS_ORIGINS=*

# Google Earth Engine (Phase 2 - satellite/NDVI)
#
# LOCAL DEVELOPMENT (recommended) — Google account OAuth, no JSON key needed:
#   pip install --upgrade earthengine-api google-auth
#   earthengine authenticate          # opens browser once, saves credentials
#   earthengine set_project your-gcp-project-id
# Then only set GEE_PROJECT below; leave the key vars empty.
#
# PRODUCTION / unattended (Render, Railway, Cloud Run):
# Create a service account, register it with Earth Engine, download its JSON key.
# Paste the full JSON contents into GEE_PRIVATE_KEY_JSON (no file mount needed).
# https://developers.google.com/earth-engine/guides/service_account
GEE_PROJECT=your-gcp-project-id
GEE_SERVICE_ACCOUNT=
GEE_PRIVATE_KEY_FILE=
GEE_PRIVATE_KEY_JSON=

# LLM — powered by Groq (free tier available)
# Get a free API key from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
# Text model for AI Assistant and Medicine Assistant
GROQ_MODEL=llama3-70b-8192
# Vision model for Disease Detection (supports image input)
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
